<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Assets["bootstrap/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorApp-SurveyJSFormLibrary.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />

    @* Form Library resources from SurveyJS and SurveyJS.JsUi *@
    <link rel="stylesheet" href="@Assets["_content/SurveyJS.Core/survey-core.min.css"]" />
    <script src="@Assets["_content/SurveyJS.Core/survey.core.min.js"]"></script>
    <script src="@Assets["_content/SurveyJS.Core/survey.i18n.min.js"]"></script>
    <script src="@Assets["_content/SurveyJS.Core/themes/index.min.js"]"></script>
    <script src="@Assets["_content/SurveyJS.JsUi/survey-js-ui.min.js"]"></script>

    @* Survey Creator resources *@
    <link rel="stylesheet" href="@Assets["_content/SurveyJS.Creator.Core/survey-creator-core.min.css"]" />
    <script src="@Assets["_content/SurveyJS.Creator.Core/survey-creator-core.min.js"]"></script>
    <script src="@Assets["_content/SurveyJS.Creator.Core/survey-creator-core.i18n.min.js"]"></script>
    <script src="@Assets["_content/SurveyJS.Creator.JsUi/survey-creator-js.min.js"]"></script>

    @* PDF Generator. jsPDF is not included in SurveyJS.Pdf. *@
    <script src="https://cdn.jsdelivr.net/npm/jspdf@4.2.1/dist/jspdf.umd.min.js"></script>
    <script src="@Assets["_content/SurveyJS.Pdf/survey.pdf.min.js"]"></script>

    @* Table View. Tabulator, jsPDF-AutoTable, and SheetJS are not included in SurveyJS.Analytics. *@
    <script src="https://unpkg.com/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
    <script src="https://unpkg.com/jspdf-autotable@3.5.20/dist/jspdf.plugin.autotable.min.js"></script>
    <script src="https://oss.sheetjs.com/sheetjs/xlsx.full.min.js"></script>
    <script src="@Assets["_content/SurveyJS.Analytics/survey.analytics.tabulator.min.js"]"></script>
    <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@6.3.1/dist/css/tabulator.min.css" />
    <link rel="stylesheet" href="@Assets["_content/SurveyJS.Analytics/survey.analytics.tabulator.min.css"]" />

    @* Dashboard. Chart.js is not included in SurveyJS.Analytics. *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="@Assets["_content/SurveyJS.Analytics/survey.analytics.min.js"]"></script>
    <link rel="stylesheet" href="@Assets["_content/SurveyJS.Analytics/survey.analytics.min.css"]" />

    <script src="@Assets["js/survey.js"]"></script>
    <script src="@Assets["js/creator.js"]"></script>
    <script src="@Assets["js/dashboard.js"]"></script>
    <script src="@Assets["js/tabulator.js"]"></script>
    <script src="@Assets["js/pdf-generator.js"]"></script>
    <script src="@Assets["data/survey_data.js"]"></script>

    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
